{
  "dataset": "orders",
  "layer": "bronze",
  "description": "Raw daily orders dataset as received from the operational system.",
  "format": "csv",
  "columns": [
    {
      "name": "order_id",
      "type": "string",
      "nullable": false,
      "description": "Unique order identifier."
    },
    {
