      "type": "string",
      "nullable": false,
      "description": "Unique customer identifier."
    },
    {
      "name": "product_id",
      "type": "string",
      "nullable": false,
      "description": "Unique product identifier."
    },
    {
      "name": "quantity",
      "type": "int",
      "nullable": false,
