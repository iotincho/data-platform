    },
    {
      "name": "unit_price",
      "type": "decimal(10,2)",
      "nullable": false,
      "description": "Price paid for a single unit."
    },
    {
      "name": "order_timestamp",
      "type": "string",
      "nullable": false,
      "description": "Purchase timestamp in ISO-8601 format."
    }
  ]
}